      "source": [
        "## Import Libraries"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "_0AZh6hVQfAV"
      },
      "outputs": [],
      "source": [
        "import torch\n",
        "from transformers import (\n",
        "    AutoTokenizer,\n",
        "    AutoModelForCausalLM,\n",
        "    TrainingArguments,\n",
        "    Trainer,\n",
        "    DataCollatorForLanguageModeling\n",
        ")\n",
        "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n",
        "from datasets import load_dataset\n",
        "import json\n",
        "from pathlib import Path\n",
        "\n",
        "print(f\"PyTorch version: {torch.__version__}\")\n",
        "print(f\"CUDA available: {torch.cuda.is_available()}\")\n",
        "if torch.cuda.is_available():\n",
        "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n",
        "    print(f\"GPU memory: {torch.cuda.get_device_properties(0).total_memory / 1024**3:.1f} GB\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "DdeUp887QfAW"
      },
      "source": [
        "## Configuration"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "LC48ffZ5QfAW"
      },
      "outputs": [],
      "source": [
        "# Model configuration\n",
        "MODEL_NAME = \"meta-llama/Meta-Llama-3.1-8B\"  # Base model\n",
        "OUTPUT_DIR = \"./synova-finetuned\"\n",
        "\n",
        "# Training configuration\n",
        "BATCH_SIZE = 4  # Adjust based on GPU memory\n",
        "GRADIENT_ACCUMULATION_STEPS = 4\n",
        "NUM_EPOCHS = 3\n",
        "LEARNING_RATE = 2e-4\n",
        "MAX_SEQ_LENGTH = 512\n",
        "\n",
        "# LoRA configuration (parameter-efficient fine-tuning)\n",
        "LORA_R = 16\n",
        "LORA_ALPHA = 32\n",
        "LORA_DROPOUT = 0.05\n",
        "LORA_TARGET_MODULES = [\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\"]\n",
        "\n",
        "print(\"Configuration loaded\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "WnirWwEYQfAW"
      },
      "source": [
        "## Load Dataset"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "DoEDVL5JQfAX"
      },
      "outputs": [],
      "source": [
        "# Option 1: Upload your dataset to Colab\n",
        "# from google.colab import files\n",
        "# uploaded = files.upload()\n",
        "# dataset_path = list(uploaded.keys())[0]\n",
        "\n",
        "# Option 2: Load from Hugging Face (if uploaded)\n",
        "# dataset = load_dataset(\"your-username/synova-dataset\")\n",
        "\n",
        "# Option 3: Create sample dataset for testing\n",
        "# Replace this with your actual dataset loading\n",
        "sample_data = [\n",
        "    {\n",
        "        \"instruction\": \"How should I implement JWT authentication in a Synova API endpoint?\",\n",
        "        \"input\": \"\",\n",
        "        \"output\": \"In Synova, JWT authentication is implemented using the middleware/auth.py module. Use the get_current_user dependency in your endpoint, and include the Authorization: Bearer <token> header in requests. The token is generated using the generate_token.py script.\"\n",
        "    },\n",
        "    {\n",
        "        \"instruction\": \"What is the recommended way to structure a new API router in Synova?\",\n",
        "        \"input\": \"\",\n",
        "        \"output\": \"Create a new file in apps/api/src/routers/ with an APIRouter instance. Define your endpoints with proper typing, error handling, and logging. Register the router in main.py with app.include_router(). Follow the patterns in existing routers like chat.py or agents.py.\"\n",
        "    }\n",
        "]\n",
        "\n",
        "# For actual use, load your JSONL file\n",
        "# def load_jsonl(file_path):\n",
        "#     data = []\n",
        "#     with open(file_path, 'r') as f:\n",
        "#         for line in f:\n",
        "#             data.append(json.loads(line))\n",
        "#     return data\n",
        "\n",
        "# dataset = load_jsonl(\"synova_dataset.jsonl\")\n",
        "\n",
        "print(f\"Loaded {len(sample_data)} examples\")\n",
        "print(f\"\\nSample example:\")\n",
        "print(json.dumps(sample_data[0], indent=2))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "XaDPALxgQfAX"
      },
      "source": [
        "## Format Dataset for Training"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "vIXGtJOLQfAY"
      },
      "outputs": [],
      "source": [
        "def format_example(example):\n",
        "    \"\"\"Format example for instruction tuning\"\"\"\n",
        "    instruction = example[\"instruction\"]\n",
        "    input_text = example.get(\"input\", \"\")\n",
        "    output = example[\"output\"]\n",
        "\n",
        "    if input_text:\n",
        "        prompt = f\"### Instruction:\\n{instruction}\\n\\n### Input:\\n{input_text}\\n\\n### Response:\\n{output}\"\n",
        "    else:\n",
        "        prompt = f\"### Instruction:\\n{instruction}\\n\\n### Response:\\n{output}\"\n",
        "\n",
        "    return prompt\n",
        "\n",
        "# Format all examples\n",
        "formatted_data = [format_example(ex) for ex in sample_data]\n",
        "\n",
        "print(f\"Formatted {len(formatted_data)} examples\")\n",
        "print(f\"\\nSample formatted example:\")\n",
        "print(formatted_data[0][:500] + \"...\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "bal3vTjIQfAY"
      },
      "source": [
        "## Load Model and Tokenizer"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "u19yG1IFQfAY"
      },
      "outputs": [],
      "source": [
        "# Load tokenizer\n",
        "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)\n",
        "tokenizer.pad_token = tokenizer.eos_token\n",
        "tokenizer.padding_side = \"right\"\n",
        "\n",
        "# Load model in 4-bit quantization (for memory efficiency)\n",
        "model = AutoModelForCausalLM.from_pretrained(\n",
        "    MODEL_NAME,\n",
        "    load_in_4bit=True,\n",
        "    torch_dtype=torch.float16,\n",
        "    device_map=\"auto\",\n",
        "    trust_remote_code=True\n",
        ")\n",
        "\n",
        "# Prepare model for k-bit training\n",
        "model = prepare_model_for_kbit_training(model)\n",
        "\n",
        "# Configure LoRA\n",
        "lora_config = LoraConfig(\n",
        "    r=LORA_R,\n",
        "    lora_alpha=LORA_ALPHA,\n",
        "    lora_dropout=LORA_DROPOUT,\n",
        "    target_modules=LORA_TARGET_MODULES,\n",
        "    bias=\"none\",\n",
        "    task_type=\"CAUSAL_LM\"\n",
        ")\n",
        "\n",
        "# Apply LoRA\n",
        "model = get_peft_model(model, lora_config)\n",
        "\n",
        "print(f\"Model loaded with LoRA\")\n",
        "print(f\"Trainable parameters: {model.print_trainable_parameters()}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "YH_MKeqTQfAZ"
      },
      "source": [
        "## Tokenize Dataset"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "43eUAgaJQfAZ"
      },
      "outputs": [],
      "source": [
        "def tokenize_function(examples):\n",
        "    return tokenizer(\n",
        "        examples,\n",
        "        truncation=True,\n",
        "        max_length=MAX_SEQ_LENGTH,\n",
        "        padding=\"max_length\"\n",
        "    )\n",
        "\n",
        "# Tokenize\n",
        "tokenized_dataset = [tokenize_function(text) for text in formatted_data]\n",
        "\n",
        "# Convert to dataset format\n",
        "from datasets import Dataset\n",
        "train_dataset = Dataset.from_list(tokenized_dataset)\n",
        "\n",
        "# Split into train/validation\n",
        "train_dataset = train_dataset.train_test_split(test_size=0.1)\n",
        "\n",
        "print(f\"Train set size: {len(train_dataset['train'])}\")\n",
        "print(f\"Validation set size: {len(train_dataset['test'])}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "LZmlmzykQfAZ"
      },
      "source": [
        "## Training Configuration"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "6ARS-YVhQfAZ"
      },
      "outputs": [],
      "source": [
        "training_args = TrainingArguments(\n",
        "    output_dir=OUTPUT_DIR,\n",
        "    num_train_epochs=NUM_EPOCHS,\n",
        "    per_device_train_batch_size=BATCH_SIZE,\n",
        "    per_device_eval_batch_size=BATCH_SIZE,\n",
        "    gradient_accumulation_steps=GRADIENT_ACCUMULATION_STEPS,\n",
        "    learning_rate=LEARNING_RATE,\n",
        "    warmup_steps=100,\n",
        "    logging_steps=10,\n",
        "    save_steps=100,\n",
        "    eval_steps=100,\n",
        "    save_total_limit=2,\n",
        "    fp16=True,\n",
        "    optim=\"paged_adamw_8bit\",\n",
        "    report_to=\"none\",  # Set to \"wandb\" if using Weights & Biases\n",
        "    load_best_model_at_end=True,\n",
        "    metric_for_best_model=\"eval_loss\",\n",
        "    greater_is_better=False\n",
        ")\n",
        "\n",
        "print(\"Training arguments configured\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "mMm7QyD1QfAZ"
      },
      "source": [
        "## Initialize Trainer"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "KH9bhsy1QfAZ"
      },
      "outputs": [],
      "source": [
        "data_collator = DataCollatorForLanguageModeling(\n",
        "    tokenizer=tokenizer,\n",
        "    mlm=False  # Causal language modeling\n",
        ")\n",
        "\n",
        "trainer = Trainer(\n",
        "    model=model,\n",
        "    args=training_args,\n",
        "    train_dataset=train_dataset[\"train\"],\n",
        "    eval_dataset=train_dataset[\"test\"],\n",
        "    data_collator=data_collator,\n",
        ")\n",
        "\n",
        "print(\"Trainer initialized\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "oLGMjNPeQfAa"
      },
      "source": [
        "## Start Training"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "jueSAeMFQfAa"
      },
      "outputs": [],
      "source": [
        "print(\"Starting training...\")\n",
        "trainer.train()\n",
        "print(\"Training complete!\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "aPZJoi_pQfAa"
      },
      "source": [
        "## Save Model"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "nB7UeITyQfAa"
      },
      "outputs": [],
      "source": [
        "# Save the fine-tuned model\n",
        "trainer.save_model(OUTPUT_DIR)\n",
        "tokenizer.save_pretrained(OUTPUT_DIR)\n",
        "\n",
        "print(f\"Model saved to {OUTPUT_DIR}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "XvVS2kqaQfAa"
      },
      "source": [
        "## Test the Fine-Tuned Model"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "qKNBJOENQfAb"
      },
      "outputs": [],
      "source": [
        "# Load the fine-tuned model\n",
        "from peft import PeftModel\n",
        "\n",
        "base_model = AutoModelForCausalLM.from_pretrained(\n",
        "    MODEL_NAME,\n",
        "    load_in_4bit=True,\n",
        "    torch_dtype=torch.float16,\n",
        "    device_map=\"auto\"\n",
        ")\n",
        "\n",
        "model = PeftModel.from_pretrained(base_model, OUTPUT_DIR)\n",
        "tokenizer = AutoTokenizer.from_pretrained(OUTPUT_DIR)\n",
        "\n",
        "# Test with a Synova-specific question\n",
        "test_instruction = \"How do I add a new endpoint to the Synova API?\"\n",
        "test_prompt = f\"### Instruction:\\n{test_instruction}\\n\\n### Response:\\n\"\n",
        "\n",
        "inputs = tokenizer(test_prompt, return_tensors=\"pt\").to(\"cuda\")\n",
        "\n",
        "with torch.no_grad():\n",
        "    outputs = model.generate(\n",
        "        **inputs,\n",
        "        max_new_tokens=200,\n",
        "        temperature=0.7,\n",
        "        do_sample=True\n",
        "    )\n",
        "\n",
        "response = tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
        "print(\"Test response:\")\n",
        "print(response)"
      ]
    },
