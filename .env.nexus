# SYNOVA NEXUS Environment Configuration

# Primary Model Configuration
NEXUS_DEFAULT_MODEL=llama4:scout
NEXUS_FALLBACK_MODELS=gemma4:e2b,synova-brain-gemma4-revolutionary,synova-brain-deepseek-revolutionary,synova-brain-production-revolutionary

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# Performance Configuration
NEXUS_MAX_TOKENS=4096
NEXUS_TEMPERATURE=0.7
NEXUS_TOP_P=0.9
NEXUS_CONTEXT_LENGTH=128000

# Feature Flags
NEXUS_NEURAL_REONANCE=true
NEXUS_QUANTUM_PROCESSING=true
NEXUS_AI_HUMAN_SYMBIOSIS=true
NEXUS_SELF_IMPROVEMENT=true
NEXUS_PREDICTIVE_ANALYTICS=true
NEXUS_MULTI_AGENT_COORDINATION=true

# API Configuration
NEXUS_API_ENDPOINT=/api/v1/chat
NEXUS_API_AUTH=bearer-token
NEXUS_RATE_LIMIT_RPM=60
NEXUS_RATE_LIMIT_BURST=10

# Streaming Configuration
NEXUS_STREAMING_ENABLED=true
NEXUS_STREAMING_CHUNK_SIZE=512

# Performance Targets
NEXUS_TARGET_LATENCY_MS=2000
NEXUS_TARGET_THROUGHPUT_RPS=100
NEXUS_TARGET_ACCURACY_PERCENT=95
NEXUS_TARGET_UPTIME_PERCENT=99.9
NEXUS_TARGET_RESOURCE_EFFICIENCY_PERCENT=80

# Scaling Configuration
NEXUS_SCALING_STRATEGY=horizontal
NEXUS_MIN_INSTANCES=1
NEXUS_MAX_INSTANCES=10
NEXUS_TARGET_CPU_PERCENT=70
NEXUS_TARGET_MEMORY_PERCENT=80
NEXUS_AUTO_SCALING=true

# Monitoring Configuration
NEXUS_MONITORING_ENABLED=true
NEXUS_METRICS=latency,throughput,accuracy,resource_usage
NEXUS_ALERTS=performance_degradation,model_failure,resource_exhaustion

# Security Configuration
NEXUS_SECURITY_LEVEL=advanced
NEXUS_ZERO_TRUST=true
NEXUS_ENCRYPTION_LEVEL=quantum

# Development Configuration
NEXUS_DEVELOPMENT_MODE=false
NEXUS_DEBUG_MODE=false
NEXUS_LOG_LEVEL=info

# Database Configuration
NEXUS_DB_URL=postgresql://localhost:5432/nexus
NEXUS_REDIS_URL=redis://localhost:6379

# Cache Configuration
NEXUS_CACHE_TTL=3600
NEXUS_CACHE_MAX_SIZE=1000

# File Storage Configuration
NEXUS_STORAGE_PATH=/var/lib/nexus
NEXUS_MAX_FILE_SIZE=100MB

# Model Storage Configuration
NEXUS_MODEL_STORAGE_PATH=/var/lib/nexus/models
NEXUS_MODEL_CACHE_SIZE=50GB
