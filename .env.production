# Synova AI v4.1 - Production Environment
# Fill in your actual token values below

# === Railway Configuration ===
# Get token from: https://railway.app → Account Settings → API Tokens
# Token format: railway_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAILWAY_TOKEN=paste_your_railway_token_here
RAILWAY_PROJECT_ID=your_railway_project_id

# === Vercel Configuration ===
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_vercel_org_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# === Expo/EAS Configuration ===
EAS_TOKEN=your_expo_eas_token_here
EAS_PROJECT_ID=your_expo_project_id_here

# === GitHub Configuration ===
GITHUB_TOKEN=your_github_token_here

# === Database Configuration ===
POSTGRES_PASSWORD=your_secure_postgres_password
REDIS_PASSWORD=your_secure_redis_password

# === API Keys ===
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# === Security ===
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here
ENCRYPTION_KEY=your_32_char_encryption_key

# === Monitoring ===
SENTRY_DSN=your_sentry_dsn_here
GRAFANA_PASSWORD=your_grafana_password

# === AWS (if using S3) ===
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_s3_bucket_name

# === Email (optional) ===
SMTP_HOST=your_smtp_host
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
