# Synova AI v4.1 - Production Environment Configuration
# Complete setup with secure defaults and required tokens

# === Core Configuration ===
NODE_ENV=production
LOG_LEVEL=info
API_VERSION=v1
ENVIRONMENT=production

# === Railway Configuration ===
# Get token from: https://railway.app -> Account Settings -> API Tokens
# Token format: 78f9c7ee-ac34-4287-9fb4-710a8b42a534
RAILWAY_TOKEN=railway_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAILWAY_PROJECT_ID=synova-ai-production

# === Vercel Configuration ===
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=vercel_token_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_ORG_ID=org_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Expo/EAS Configuration ===
# Get from: https://expo.dev/accounts/[username]/access-tokens
EAS_TOKEN=exxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EAS_PROJECT_ID=synova-xr-workspace

# === GitHub Configuration ===
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Database Configuration ===
POSTGRES_PASSWORD=SynovaSecureDB2024!@#
REDIS_PASSWORD=SynovaRedis2024!@#
DATABASE_URL=postgresql://synova_user:SynovaSecureDB2024!#@synova-db:5432/synova_ai
REDIS_URL=redis://:SynovaRedis2024!#@synova-redis:6379

# === AI/ML Configuration ===
OLLAMA_HOST=http://synova-brain:11434
SYNOVA_BRAIN_MODEL=synova-brain-v3.2
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Authentication & Security ===
JWT_SECRET=SynovaJWTSecret2024UltraSecure32CharKey!
SESSION_SECRET=SynovaSessionSecret2024UltraSecureKey!
ENCRYPTION_KEY=SynovaEncryptKey2024Secure32Chars!

# === Frontend Configuration ===
NEXT_PUBLIC_API_URL=https://api.synova.ai
NEXT_PUBLIC_RENDERER_URL=https://renderer.synova.ai
NEXT_PUBLIC_WS_URL=wss://api.synova.ai/ws
NEXT_PUBLIC_APP_VERSION=4.1.0

# === Mobile App Configuration ===
EXPO_PUBLIC_CONVEX_URL=https://convex.synova.ai
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# === Monitoring & Analytics ===
# Sentry DSN is optional - comment out if not using
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxx.ingest.sentry.io/xxxxxxx
GRAFANA_PASSWORD=SynovaGrafana2024!@#
PROMETHEUS_RETENTION=200h

# === File Storage ===
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=synova-ai-assets
AWS_REGION=us-east-1

# === Email Configuration ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@synova.ai
SMTP_PASS=your_app_password_here

# === Feature Flags ===
FEATURE_XR_RENDERING=true
FEATURE_AI_CHAT=true
FEATURE_REAL_TIME_COLLAB=true
FEATURE_ANALYTICS=true
FEATURE_BILLING=false

# === Performance ===
CACHE_TTL=3600
RATE_LIMIT_WINDOW=90000
RATE_LIMIT_MAX=100

# === Compliance ===
GDPR_COMPLIANT=true
CCPA_COMPLIANT=true
DATA_RETENTION_DAYS=365

# === Internal Service URIs ===
CORE_API_URL=http://synova-core-api:8000
RENDERER_URL=http://synova-holo-renderer:3001
UI_SYSTEM_URL=http://synova-ui-system:3000
NGINX_URL=http://synova-nginx:80

# === Development Tools ===
ADMINER_URL=http://synova-adminer:8080
REDIS_COMMANDER_URL=http://synova-redis-commander:8081

# === Monitoring URIs ===
PROMETHEUS_URL=http://synova-prometheus:9090
GRAFANA_URL=http://synova-grafana:3000
LOKI_URL=http://synova-loki:3100
