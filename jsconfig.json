{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ESnext",
        "jsx": "react-jsx",
        "allowImportingTsExtensions": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./components/*"],
            "@/lib/*": ["./lib/*"],
            "@/api/*": ["./pages/api/*"],
            "@/styles/*": ["./styles/*"]
        }
    },
    "include": [
        "pages/**/*",
        "components/**/*",
        "lib/**/*",
        "styles/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules/*",
        ".next",
        "out",
        "build",
        "dist",
        "**/*.lock",
        "**/*.lockfile"
    ]
}