#!/usr/bin/env node

/**
 * Synova CLI Tool
 * Unified command-line interface for managing the Synova Workspace
 */

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const VERSION = '1.0.0';
const WORKSPACE_ROOT = path.resolve(__dirname, '..');

// Color codes for terminal output
const colors = {
  reset: '\x1b[0m',
  bright: '\x1b[1m',
  red: '\x1b[31m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  blue: '\x1b[34m',
  cyan: '\x1b[36m',
};

function log(message, color = 'reset') {
  console.log(`${colors[color]}${message}${colors.reset}`);
}

function error(message) {
  log(`✗ Error: ${message}`, 'red');
  process.exit(1);
}

function success(message) {
  log(`✓ ${message}`, 'green');
}

function info(message) {
  log(`ℹ ${message}`, 'cyan');
}

function exec(command, cwd = WORKSPACE_ROOT) {
  try {
    return execSync(command, { cwd, stdio: 'inherit' });
  } catch (err) {
    error(`Command failed: ${command}`);
  }
}

// Commands
const commands = {
  install: {
    description: 'Install all dependencies',
    run: () => {
      info('Installing dependencies...');
      exec('./scripts/install-all.sh');
      success('Dependencies installed');
    },
  },

  start: {
    description: 'Start all services',
    run: () => {
      info('Starting all services...');
      exec('docker-compose up -d');
      success('Services started');
    },
  },

  stop: {
    description: 'Stop all services',
    run: () => {
      info('Stopping all services...');
      exec('docker-compose down');
      success('Services stopped');
    },
  },

  build: {
    description: 'Build all packages',
    run: () => {
      info('Building packages...');
      const packages = [
        'synova-packages-supanova-sdk',
        'synova-ui-system',
        'synova-holo-renderer',
      ];

      packages.forEach(pkg => {
        info(`Building ${pkg}...`);
        exec(`cd ${pkg} && npm run build`);
      });

      success('All packages built');
    },
  },

  test: {
    description: 'Run tests',
    run: () => {
      info('Running tests...');
      exec('npm run test:all');
      success('Tests completed');
    },
  },

  lint: {
    description: 'Run linting',
    run: () => {
      info('Running linting...');
      exec('npm run lint');
      success('Linting completed');
    },
  },

  format: {
    description: 'Format code',
    run: () => {
      info('Formatting code...');
      exec('npm run format');
      success('Code formatted');
    },
  },

  dev: {
    description: 'Start development environment',
    run: () => {
      info('Starting development environment...');
      exec('docker-compose -f docker-compose.yml up -d');
      info('Services are running. Access them at:');
      log('  - UI System: http://localhost:3000', 'cyan');
      log('  - Core API: http://localhost:8000', 'cyan');
      log('  - Holo Renderer: http://localhost:3001', 'cyan');
      log('  - Grafana: http://localhost:9000', 'cyan');
      log('  - Prometheus: http://localhost:9090', 'cyan');
    },
  },

  logs: {
    description: 'View service logs',
    run: (service) => {
      if (!service) {
        info('Showing logs for all services...');
        exec('docker-compose logs -f');
      } else {
        info(`Showing logs for ${service}...`);
        exec(`docker-compose logs -f ${service}`);
      }
    },
  },

  status: {
    description: 'Show service status',
    run: () => {
      info('Service status:');
      exec('docker-compose ps');
    },
  },

  health: {
    description: 'Check service health',
    run: () => {
      info('Checking service health...');
      const endpoints = [
        { name: 'Core API', url: 'http://localhost:8000/health' },
        { name: 'UI System', url: 'http://localhost:3000/health' },
        { name: 'Holo Renderer', url: 'http://localhost:3001/health' },
      ];

      endpoints.forEach(({ name, url }) => {
        try {
          const result = execSync(`curl -s ${url}`, { encoding: 'utf-8' });
          success(`${name}: OK`);
        } catch {
          log(`${name}: UNAVAILABLE`, 'yellow');
        }
      });
    },
  },

  version: {
    description: 'Show version',
    run: () => {
      log(`Synova CLI v${VERSION}`, 'cyan');
    },
  },

  help: {
    description: 'Show help',
    run: () => {
      log('\nSynova CLI - Workspace Management Tool', 'bright');
      log(`v${VERSION}\n`, 'cyan');
      log('Usage: synova <command> [options]\n', 'bright');
      log('Commands:', 'bright');

      Object.entries(commands).forEach(([name, { description }]) => {
        log(`  ${name.padEnd(15)} ${description}`, 'cyan');
      });

      log('\nExamples:', 'bright');
      log('  synova install     Install all dependencies');
      log('  synova start       Start all services');
      log('  synova dev         Start development environment');
      log('  synova logs        View service logs');
      log('  synova status      Show service status\n');
    },
  },
};

// Main CLI logic
const command = process.argv[2] || 'help';
const args = process.argv.slice(3);

if (commands[command]) {
  try {
    commands[command].run(...args);
  } catch (err) {
    error(err.message);
  }
} else {
  error(`Unknown command: ${command}`);
  commands.help.run();
}
