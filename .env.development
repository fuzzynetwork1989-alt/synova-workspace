# Development Environment Configuration
NODE_ENV=development
LOG_LEVEL=debug

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
API_URL=http://localhost:3000/api

# Redis Configuration (for local testing)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Database Configuration
# DATABASE_URL=postgresql://localhost:5432/synova_dev

# Authentication (use development secrets)
JWT_SECRET=dev-jwt-secret-key-32-chars-long
SESSION_SECRET=dev-session-secret-32-chars-long

# Feature Flags
ENABLE_CACHE=false
ENABLE_RATE_LIMITING=false
ENABLE_CDN=false

# Rate Limiting (disabled in dev)
RATE_LIMIT_GLOBAL=10000
RATE_LIMIT_GENERATION=100
RATE_LIMIT_UPLOAD=50

# Cache TTL (not used when cache disabled)
CACHE_TTL_API=60
CACHE_TTL_GENERATION=300
CACHE_TTL_UPLOAD=3600

# External Services
# SENTRY_DSN=

# CDN Configuration (disabled in dev)
# CDN_URL=
# ASSET_PREFIX=
