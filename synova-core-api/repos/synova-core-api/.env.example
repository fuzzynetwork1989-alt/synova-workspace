# 🧠 SYNOVA AI - PURE KNOWLEDGE ENVIRONMENT CONFIGURATION
# 🔑 Your Own API Key System - Complete Business Model
# Copy this file to .env and configure with your actual values

# Database Configuration
DATABASE_URL=sqlite:///./synova_ai.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/synova_db
REDIS_URL=redis://localhost:6379
PGVECTOR_ENABLED=true

# 🔑 AI PROVIDER API KEYS - CRITICAL FOR BUSINESS MODEL
# OpenAI API Key (for code generation and reasoning)
OPENAI_API_KEY=sk-your-openai-api-key-here
# Anthropic API Key (for analysis and writing)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# Google AI API Key (for general and multimodal tasks)
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Authentication & Security
JWT_SECRET=dev-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=dev-super-secret-refresh-key-change-this-in-production
ENCRYPTION_KEY=dev-encryption-key-32-chars-long-exactly-32-chars

# Application Configuration
APP_ENV=development
APP_NAME=synova-ai
APP_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api/v1
WEB_BASE_URL=http://localhost:3000
MOBILE_BASE_URL=http://localhost:8081

# 💰 BUSINESS MODEL CONFIGURATION
# API Key Pricing Tiers
FREE_TIER_REQUESTS=100
FREE_TIER_TOKENS=10000
FREE_TIER_MONTHLY_RATE=0
FREE_TIER_COST_PER_REQUEST=0

PRO_TIER_REQUESTS=10000
PRO_TIER_TOKENS=1000000
PRO_TIER_MONTHLY_RATE=29
PRO_TIER_COST_PER_REQUEST=0.0029

ENTERPRISE_TIER_REQUESTS=100000
ENTERPRISE_TIER_TOKENS=10000000
ENTERPRISE_TIER_MONTHLY_RATE=199
ENTERPRISE_TIER_COST_PER_REQUEST=0.00199

# 🤖 AI ROUTING CONFIGURATION
# Provider costs per token (for profit calculation)
OPENAI_COST_PER_TOKEN=0.00002
ANTHROPIC_COST_PER_TOKEN=0.00003
GOOGLE_AI_COST_PER_TOKEN=0.00001

# Routing preferences by tier
FREE_TIER_PREFERRED_PROVIDER=google
PRO_TIER_PREFERRED_PROVIDER=openai
ENTERPRISE_TIER_PREFERRED_PROVIDER=anthropic

# Feature Flags
ENABLE_API_KEY_SYSTEM=true
ENABLE_SMART_ROUTING=true
ENABLE_PROFIT_TRACKING=true
ENABLE_USAGE_ANALYTICS=true
ENABLE_PURE_KNOWLEDGE=true
ENABLE_BUSINESS_METRICS=true

# Pure Knowledge System
PURE_KNOWLEDGE_BRIDGE_PATH=./src/services/synovaPureKnowledgeBridge.py
PYTHON_EXECUTABLE=python3

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:8082,https://localhost:3001,https://localhost:8082

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX=20
API_KEY_RATE_LIMIT_FREE=10
API_KEY_RATE_LIMIT_PRO=100
API_KEY_RATE_LIMIT_ENTERPRISE=1000

# Logging & Monitoring
LOG_LEVEL=info
ENABLE_ERROR_TRACKING=true
ENABLE_USAGE_TRACKING=true
ENABLE_PERFORMANCE_MONITORING=true

# 🚀 DEPLOYMENT CONFIGURATION
# Production settings
NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# SSL Configuration (for production)
SSL_ENABLED=false
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# 📊 ANALYTICS & MONITORING
# Optional: Add your analytics keys
SENTRY_DSN=your-sentry-dsn-here
GOOGLE_ANALYTICS_ID=your-ga-id-here
MIXPANEL_TOKEN=your-mixpanel-token-here

# 💳 PAYMENT PROCESSING (Optional for future monetization)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# 🌍 MULTI-REGION CONFIGURATION
DEFAULT_REGION=us-east-1
ENABLE_CDN=false
CDN_BASE_URL=https://cdn.synova.ai

# 🔧 DEVELOPMENT SETTINGS
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_SWAGGER_DOCS=true
ENABLE_RELOAD=true
ENABLE_AUTO_MIGRATION=true
