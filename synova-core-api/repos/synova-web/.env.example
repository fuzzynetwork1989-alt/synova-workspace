# Synova Web Environment Configuration Example
# Copy this file to .env.local and configure with your actual values

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Synova AI
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_DEBUG_MODE=true

# Feature Flags
NEXT_PUBLIC_ENABLE_ASTRANOVA=true
NEXT_PUBLIC_ENABLE_XR=true
NEXT_PUBLIC_ENABLE_CLIENT_AI=true

# Analytics
NEXT_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key-here
