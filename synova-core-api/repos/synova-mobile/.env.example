# Synova Mobile Environment Configuration Example
# Copy this file to .env and configure with your actual values

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Development Configuration
EXPO_PUBLIC_DEV_MODE=true
EXPO_PUBLIC_DEBUG_MODE=true

# Feature Flags
EXPO_PUBLIC_ENABLE_CLIENT_AI=true
EXPO_PUBLIC_ENABLE_VOICE=true
EXPO_PUBLIC_ENABLE_VISION=true
EXPO_PUBLIC_ENABLE_ASTRANOVA=true
EXPO_PUBLIC_ENABLE_XR=true

# Analytics
EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key-here
