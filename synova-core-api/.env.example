# Synova AI Environment Configuration Example
# Copy this file to .env.local and configure with your actual values

# Application Configuration
APP_ENV=development
APP_NAME=synova-ai
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api/v1
WEB_BASE_URL=http://localhost:3000

# Synova Brain Configuration
SYNOVA_BRAIN_ENABLED=true
SYNOVA_BRAIN_MODEL=advanced-llm-v2
SYNOVA_BRAIN_CONSCIOUSNESS_LEVEL=0.95
SYNOVA_BRAIN_MEMORY_LAYERS=8
SYNOVA_BRAIN_REASONING_TYPES=9
SYNOVA_BRAIN_LEARNING_RATE=0.001
SYNOVA_BRAIN_MAX_TOKENS=8192
SYNOVA_BRAIN_TEMPERATURE=0.7

# Synova Brain Memory Configuration
SYNOVA_MEMORY_SHORT_TERM_SIZE=100
SYNOVA_MEMORY_WORKING_SIZE=50
SYNOVA_MEMORY_LONG_TERM_SIZE=10000
SYNOVA_MEMORY_EPISODIC_SIZE=1000
SYNOVA_MEMORY_SEMANTIC_SIZE=5000
SYNOVA_MEMORY_PROCEDURAL_SIZE=1000
SYNOVA_MEMORY_EMOTIONAL_SIZE=500
SYNOVA_MEMORY_CONTEXTUAL_SIZE=200

# Synova Brain Reasoning Configuration
SYNOVA_REASONING_DEDUCTIVE=true
SYNOVA_REASONING_INDUCTIVE=true
SYNOVA_REASONING_ABDUCTIVE=true
SYNOVA_REASONING_CAUSAL=true
SYNOVA_REASONING_ANALOGICAL=true
SYNOVA_REASONING_CRITICAL=true
SYNOVA_REASONING_SYSTEMS=true
SYNOVA_REASONING_META=true

# Synova Brain Creativity Configuration
SYNOVA_CREATIVITY_ENABLED=true
SYNOVA_CREATIVITY_IDEA_GENERATION=true
SYNOVA_CREATIVITY_PATTERN_RECOGNITION=true
SYNOVA_CREATIVITY_METAPHOR_CREATION=true
SYNOVA_CREATIVITY_SYNTHESIS=true
SYNOVA_CREATIVITY_DIVERGENT=true
SYNOVA_CREATIVITY_CONVERGENT=true

# Synova Brain Emotional Intelligence
SYNOVA_EMOTIONAL_INTELLIGENCE=true
SYNOVA_EMOTION_RECOGNITION=true
SYNOVA_EMPATHY_SIMULATION=true
SYNOVA_SOCIAL_COGNITION=true
SYNOVA_PERSONALITY_MODELING=true
SYNOVA_EMOTIONAL_REASONING=true

# Deep Research Engine Configuration
SYNOVA_RESEARCH_ENABLED=true
SYNOVA_RESEARCH_MAX_SOURCES=100
SYNOVA_RESEARCH_MIN_CREDIBILITY=0.7
SYNOVA_RESEARCH_INCLUDE_PEER_REVIEWED=true
SYNOVA_RESEARCH_INCLUDE_OPEN_ACCESS=false
SYNOVA_RESEARCH_QUALITY_ASSESSMENT=true
SYNOVA_RESEARCH_FACT_CHECKING=true

# Academic Database Configuration
SYNOVA_ARXIV_ENABLED=true
SYNOVA_PUBMED_ENABLED=true
SYNOVA_GOOGLE_SCHOLAR_ENABLED=true
SYNOVA_SEMANTIC_SCHOLAR_ENABLED=true
SYNOVA_JSTOR_ENABLED=true
SYNOVA_SCIENCEDIRECT_ENABLED=true
SYNOVA_SPRINGER_ENABLED=true
SYNOVA_NATURE_ENABLED=true
SYNOVA_IEEE_ENABLED=true
SYNOVA_ACM_ENABLED=true

# News Source Configuration
SYNOVA_NYT_ENABLED=true
SYNOVA_WASHINGTON_POST_ENABLED=true
SYNOVA_BBC_ENABLED=true
SYNOVA_REUTERS_ENABLED=true
SYNOVA_ASSOCIATED_PRESS_ENABLED=true
SYNOVA_GUARDIAN_ENABLED=true
SYNOVA_WALL_STREET_JOURNAL_ENABLED=true
SYNOVA_FINANCIAL_TIMES_ENABLED=true

# Web Search Configuration
SYNOVA_GOOGLE_SEARCH_ENABLED=true
SYNOVA_BING_SEARCH_ENABLED=true
SYNOVA_DUCKDUCKGO_ENABLED=true
SYNOVA_BRAVE_SEARCH_ENABLED=true

# Specialized Sources Configuration
SYNOVA_WIKIPEDIA_ENABLED=true
SYNOVA_STACK_EXCHANGE_ENABLED=true
SYNOVA_GITHUB_ENABLED=true
SYNOVA_REDDIT_ENABLED=true
SYNOVA_QUORA_ENABLED=true
SYNOVA_MEDIUM_ENABLED=true

# Revolutionary Features Configuration
SYNOVA_QUANTUM_AI_PREDICTION=true
SYNOVA_NEURAL_SYNCHRONIZATION=true
SYNOVA_CONSCIOUSNESS_RENDERING=true
SYNOVA_DNA_DATA_STORAGE=true
SYNOVA_TELEPATHIC_SEARCH=true
SYNOVA_QUANTUM_TAB_MANAGEMENT=true
SYNOVA_TIME_TRAVEL_BROWSING=true
SYNOVA_MULTIDIMENSIONAL_NAVIGATION=true
SYNOVA_HOLOGRAPHIC_BROWSING=true
SYNOVA_REALITY_BROWSING=true

# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/synova_db
REDIS_URL=redis://localhost:6379
PGVECTOR_ENABLED=true

# Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-long-exactly-32-chars
SESSION_COOKIE_NAME=synova_session
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Biometric Authentication
BIOMETRIC_AUTH_ENABLED=true
FINGERPRINT_AUTH=true
FACE_ID_AUTH=true
NEURAL_AUTH=true

# Multi-tenant Configuration
MULTI_TENANT_ENABLED=true
DEFAULT_TENANT_PLAN=pro
ENABLE_SIGNUPS=true
ENABLE_CLIENT_AI=true
ENABLE_ASTRANOVA=true
ENABLE_SUPANOVA=true
ENABLE_XR=true
ENABLE_VR=true
ENABLE_VIKTOR=true

# Model Configuration
MODEL_DEFAULT_PROVIDER=synova-brain
MODEL_DEFAULT_NAME=synova-advanced-v2
MODEL_FALLBACK_PROVIDER=openai
MODEL_ROUTER_POLICY=balanced
LOCALAI_BASE_URL=http://localhost:8080
VLLM_BASE_URL=http://localhost:8000
OLLAMA_BASE_URL=http://localhost:11434

# External API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
GROQ_API_KEY=your-groq-api-key
HUGGINGFACE_TOKEN=your-huggingface-token

# Astranova AI Configuration
ASTRANOVA_API_KEY=your-astranova-api-key
ASTRANOVA_BASE_URL=https://api.astranova.ai
ASTRANOVA_MODEL=astranova-pro
ASTRANOVA_MAX_TOKENS=4096
ASTRANOVA_TEMPERATURE=0.7

# Supanova Configuration
SUPANOVA_API_KEY=your-supanova-api-key
SUPANOVA_BASE_URL=https://api.supanova.ai
SUPANOVA_MODEL=supanova-ultra
SUPANOVA_MAX_TOKENS=8192
SUPANOVA_TEMPERATURE=0.5
SUPANOVA_ENABLE_MULTI_MODAL=true

# XR/VR Configuration
XR_PROVIDER=oculus
XR_SDK_VERSION=latest
VR_WEBXR_SUPPORT=true
XR_HAND_TRACKING=true
XR_EYE_TRACKING=true
XR_SPATIAL_AUDIO=true
XR_ROOM_SCALE=true
XR_PASS_THROUGH=true

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:8082,https://localhost:3001,https://localhost:8082

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX=20

# Logging Configuration
LOG_LEVEL=debug
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_MONITORING=true

# Security Configuration
ENABLE_END_TO_END_ENCRYPTION=true
ENABLE_BIOMETRIC_SECURITY=true
ENABLE_NEURAL_SECURITY=true
ENABLE_QUANTUM_SECURITY=true

# Performance Configuration
ENABLE_CACHING=true
ENABLE_LAZY_LOADING=true
ENABLE_COMPRESSION=true
ENABLE_OPTIMIZATION=true

# Analytics Configuration
ENABLE_USAGE_ANALYTICS=true
ENABLE_PERFORMANCE_ANALYTICS=true
ENABLE_QUALITY_TRACKING=true
ENABLE_ERROR_MONITORING=true

# Enterprise Features
ENABLE_WEBHOOKS=true
ENABLE_THIRD_PARTY_INTEGRATION=true
ENABLE_CUSTOM_SOLUTIONS=true
ENABLE_API_INTEGRATION=true

# Production Configuration
PRODUCTION_READY=true
APP_STORE_OPTIMIZED=true
ENTERPRISE_GRADE=true

# ===========================================
# VOICE AND VISION
# ===========================================
VOICE_PROVIDER=elevenlabs
VOICE_API_KEY=your-elevenlabs-key-here
VISION_PROVIDER=openai
VISION_API_KEY=sk-your-vision-key-here

# ===========================================
# VIKTOR ENGINEERING AUTOMATION
# ===========================================
VIKTOR_API_KEY=your-viktor-api-key-here
VIKTOR_BASE_URL=https://api.viktor.ai

# ===========================================
# OBSERVABILITY
# ===========================================
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io/v1/traces
OTEL_EXPORTER_TOKEN=your-honeycomb-token-here
SENTRY_DSN=https://your-sentry-dsn-here
POSTHOG_API_KEY=phc_your-posthog-key-here

# ===========================================
# BILLING
# ===========================================
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# ===========================================
# CORS
# ===========================================
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3001,http://localhost:8081,https://localhost:8082,https://synova-web.vercel.app

# ===========================================
# LAUNCH CHECKLIST
# ===========================================
LAUNCH_CHECKLIST_PATH=./config/synova-launch-checklist-v1.0.json
