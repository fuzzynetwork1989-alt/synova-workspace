# Database (using Docker for local development)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/synova_db
REDIS_URL=redis://localhost:6379

# Development settings
APP_ENV=development
APP_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api/v1
WEB_BASE_URL=http://localhost:3000

# JWT secrets (development only)
JWT_SECRET=dev-super-secret-jwt-key-not-for-production-change-this-in-production
JWT_REFRESH_SECRET=dev-super-secret-refresh-key-not-for-production-change-this
ENCRYPTION_KEY=dev-encryption-key-32-chars-long-exactly-32-chars

# Model configuration (using Synova Brain)
MODEL_DEFAULT_PROVIDER=synova-brain
MODEL_DEFAULT_NAME=synova-advanced-v2
OLLAMA_BASE_URL=http://localhost:11434

# Astranova AI Agent System
ASTRANOVA_API_KEY=dev-astranova-key
ASTRANOVA_BASE_URL=https://api.astranova.ai
ASTRANOVA_MODEL=astranova-pro
ASTRANOVA_MAX_TOKENS=4096
ASTRANOVA_TEMPERATURE=0.7

# Supanova Super-Agent System
SUPANOVA_API_KEY=dev-supanova-key
SUPANOVA_BASE_URL=https://api.supanova.ai
SUPANOVA_MODEL=supanova-ultra
SUPANOVA_MAX_TOKENS=8192
SUPANOVA_TEMPERATURE=0.5
SUPANOVA_ENABLE_MULTI_MODAL=true

# XR/VR Configuration
XR_PROVIDER=oculus
XR_SDK_VERSION=latest
VR_WEBXR_SUPPORT=true
XR_HAND_TRACKING=true
XR_EYE_TRACKING=true
XR_SPATIAL_AUDIO=true
XR_ROOM_SCALE=true
XR_PASS_THROUGH=true

# Additional configuration for local development
ENABLE_SIGNUPS=true
ENABLE_CLIENT_AI=true
ENABLE_ASTRANOVA=true
ENABLE_SUPANOVA=true
ENABLE_XR=true
ENABLE_VR=true
ENABLE_VIKTOR=true

# Rate limiting (relaxed for development)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX=20

# CORS (open for development)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:8082,https://localhost:3001,https://localhost:8082

# Logging (verbose for development)
LOG_LEVEL=debug
ENABLE_ERROR_TRACKING=true
ENABLE_PERFORMANCE_MONITORING=true

# Security Configuration
ENABLE_END_TO_END_ENCRYPTION=true
ENABLE_BIOMETRIC_SECURITY=true
ENABLE_NEURAL_SECURITY=true
ENABLE_QUANTUM_SECURITY=true

# Performance Configuration
ENABLE_CACHING=true
ENABLE_LAZY_LOADING=true
ENABLE_COMPRESSION=true
ENABLE_OPTIMIZATION=true

# Analytics Configuration
ENABLE_USAGE_ANALYTICS=true
ENABLE_PERFORMANCE_ANALYTICS=true
ENABLE_QUALITY_TRACKING=true
ENABLE_ERROR_MONITORING=true
