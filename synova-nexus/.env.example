# Synova Nexus Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ================================
# LLM PROVIDER CONFIGURATIONS
# ================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_openai_org_id_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=4096

# Google AI Configuration
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GOOGLE_AI_MODEL=gemini-pro

# Hugging Face Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=microsoft/DialoGPT-large

# ================================
# DATABASE CONFIGURATIONS
# ================================

# PostgreSQL Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/synova_nexus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synova_nexus
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ================================
# EXTERNAL API CONFIGURATIONS
# ================================

# Google Search API
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Bing Search API
BING_SEARCH_API_KEY=your_bing_search_api_key_here
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Voice Recognition (Speech-to-Text)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# Voice Synthesis (Text-to-Speech)
AZURE_TTS_KEY=your_azure_tts_key_here
AZURE_TTS_REGION=eastus
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ================================
# AUTHENTICATION CONFIGURATIONS
# ================================

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ================================
# XR AND DEVICE CONFIGURATIONS
# ================================

# WebXR Configuration
WEBXR_REQUIRED_FEATURES=hand-tracking,local-floor
WEBXR_OPTIONAL_FEATURES=hit-test,anchors

# Device SDK Configuration
OCULUS_APP_ID=your_oculus_app_id_here
OCULUS_APP_SECRET=your_oculus_app_secret_here

# ================================
# MONITORING AND ANALYTICS
# ================================

# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn_here

# PostHog (Analytics)
POSTHOG_API_KEY=your_posthog_api_key_here
POSTHOG_HOST=https://app.posthog.com

# ================================
# DEVELOPMENT CONFIGURATIONS
# ================================

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# QUANTUM COMPUTING CONFIGURATIONS
# ================================

# IBM Quantum
IBM_QUANTUM_API_TOKEN=your_ibm_quantum_token_here
IBM_QUANTUM_BACKEND=ibmq_qasm_simulator

# Azure Quantum
AZURE_QUANTUM_SUBSCRIPTION_ID=your_azure_subscription_id_here
AZURE_QUANTUM_RESOURCE_GROUP=your_resource_group_here
AZURE_QUANTUM_WORKSPACE=your_quantum_workspace_here

# ================================
# BIOMETRIC SENSORS
# ================================

# Heart Rate Monitor
HEART_RATE_DEVICE_PORT=COM3
HEART_RATE_BAUD_RATE=9600

# EEG/Brain Interface
BRAIN_INTERFACE_SDK_PATH=/path/to/brain-interface-sdk
BRAIN_INTERFACE_PORT=8080

# ================================
# SECURITY CONFIGURATIONS
# ================================

# Encryption
ENCRYPTION_KEY=your_32_byte_encryption_key_here
ENCRYPTION_IV=your_16_byte_iv_here

# API Security
API_KEY_HEADER=X-API-Key
API_RATE_LIMIT=1000
API_TIMEOUT=30000
