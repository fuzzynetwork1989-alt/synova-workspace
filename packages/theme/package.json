{
  "name": "@synova/theme",
  "version": "1.0.0",
  "description": "Unified theme configuration for Synova Workspace",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./colors": {
      "import": "./dist/colors.js",
      "require": "./dist/colors.js",
      "types": "./dist/colors.d.ts"
    },
    "./typography": {
      "import": "./dist/typography.js",
      "require": "./dist/typography.js",
      "types": "./dist/typography.d.ts"
    },
    "./tailwind": "./tailwind.config.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "theme",
    "design-system",
    "synova",
    "tailwind",
    "colors",
    "typography"
  ],
  "author": "Synova AI",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tailwindcss": "^3.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.0.0"
  }
}
