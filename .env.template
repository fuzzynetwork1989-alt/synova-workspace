# Synova AI v4.1 - Environment Configuration Template
# Copy this file to .env.local for development, .env.production for production

# === Core Configuration ===
NODE_ENV=production
LOG_LEVEL=info
API_VERSION=v1

# === Database Configuration ===
DATABASE_URL=postgresql://synova_user:${POSTGRES_PASSWORD}@synova-db:5432/synova_ai
REDIS_URL=redis://:${REDIS_PASSWORD}@synova-redis:6379

# === AI/ML Configuration ===
OLLAMA_HOST=http://synova-brain:11434
SYNOVA_BRAIN_MODEL=synova-brain-v3.2
OPENAI_API_KEY=${OPENAI_API_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# === Authentication & Security ===
JWT_SECRET=${JWT_SECRET}
SESSION_SECRET=${SESSION_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}

# === External Services ===
RAILWAY_TOKEN=${RAILWAY_TOKEN}
VERCEL_TOKEN=${VERCEL_TOKEN}
EAS_TOKEN=${EAS_TOKEN}
EAS_PROJECT_ID=${EAS_PROJECT_ID}

# === Frontend Configuration ===
NEXT_PUBLIC_API_URL=https://api.synova.ai
NEXT_PUBLIC_RENDERER_URL=https://renderer.synova.ai
NEXT_PUBLIC_WS_URL=wss://api.synova.ai/ws
NEXT_PUBLIC_APP_VERSION=4.1.0

# === Mobile App Configuration ===
EXPO_PUBLIC_CONVEX_URL=${EXPO_PUBLIC_CONVEX_URL}
EXPO_PUBLIC_OPENAI_API_KEY=${EXPO_PUBLIC_OPENAI_API_KEY}
EXPO_PUBLIC_ANTHROPIC_API_KEY=${EXPO_PUBLIC_ANTHROPIC_API_KEY}

# === Monitoring & Analytics ===
SENTRY_DSN=${SENTRY_DSN}
GRAFANA_PASSWORD=${GRAFANA_PASSWORD}
PROMETHEUS_RETENTION=200h

# === File Storage ===
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_S3_BUCKET=synova-ai-assets
AWS_REGION=us-east-1

# === Email Configuration ===
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}

# === Feature Flags ===
FEATURE_XR_RENDERING=true
FEATURE_AI_CHAT=true
FEATURE_REAL_TIME_COLLAB=true
FEATURE_ANALYTICS=true
FEATURE_BILLING=false

# === Performance ===
CACHE_TTL=3600
RATE_LIMIT_WINDOW=90000
RATE_LIMIT_MAX=100

# === Compliance ===
GDPR_COMPLIANT=true
CCPA_COMPLIANT=true
DATA_RETENTION_DAYS=365
