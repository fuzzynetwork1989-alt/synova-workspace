# Staging Environment Configuration
NODE_ENV=staging
LOG_LEVEL=info

# API Configuration
NEXT_PUBLIC_API_URL=https://staging-api.synova.ai
API_URL=https://staging-api.synova.ai
RAILWAY_API_URL=https://staging-synova-brain.up.railway.app

# Redis Configuration
REDIS_HOST=staging-redis.synova.ai
REDIS_PORT=6379
REDIS_PASSWORD=staging-redis-secure-password

# Database Configuration
DATABASE_URL=postgresql://synova_user:staging_password@staging-db.synova.ai:5432/synova_staging

# Authentication (use staging secrets)
JWT_SECRET=staging-jwt-secret-key-32-chars-long-secure
SESSION_SECRET=staging-session-secret-32-chars-secure

# Feature Flags
ENABLE_CACHE=true
ENABLE_RATE_LIMITING=true
ENABLE_CDN=true

# Rate Limiting
RATE_LIMIT_GLOBAL=500
RATE_LIMIT_GENERATION=20
RATE_LIMIT_UPLOAD=10

# Cache TTL
CACHE_TTL_API=300
CACHE_TTL_GENERATION=1800
CACHE_TTL_UPLOAD=43200

# External Services
SENTRY_DSN=https://staging-sentry.synova.ai/sentry-project-id

# CDN Configuration
CDN_URL=https://staging-cdn.synova.ai
ASSET_PREFIX=https://staging-cdn.synova.ai
